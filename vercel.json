{
  "framework": "vite",
  "installCommand": "npm install --include=dev && npm install --prefix server --include=dev",
  "buildCommand": "npm run schema:embed && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[[...route]].ts": {
      "maxDuration": 60,
      "includeFiles": "server/src/db/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
