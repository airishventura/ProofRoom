# ── Frontend (Vite build / local dev) ─────────────────────────────
# same = browser calls /api (Vite/nginx proxy) — avoids offline on non-localhost URLs
# http://localhost:8787 = direct API (only works when page is also on localhost)
# off = local mock, no backend
VITE_API_URL=same

# ── Server ────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
# production: JWT_SECRET ≥ 32 chars; SEED_DEMO=false
SEED_DEMO=true
DATABASE_URL=postgresql://proofroom:proofroom@localhost:5432/proofroom
JWT_SECRET=dev-proofroom-secret-change-me
JWT_TTL=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
PUBLIC_APP_URL=http://localhost:5173

# Rate limits (optional; prod defaults are stricter)
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_CHAT=30
# RATE_LIMIT_CHAT_WINDOW_MS=60000

# Redis multi-instance rate limits (optional locally; compose sets redis://redis:6379)
# REDIS_URL=redis://127.0.0.1:6379

# Publish PDF / object storage
# OBJECT_STORAGE_PATH=./server/data/objects

# SSO / OIDC (optional)
# OIDC_ISSUER=https://accounts.example.com
# OIDC_AUDIENCE=proofroom
# OIDC_JWKS_URL=https://accounts.example.com/.well-known/jwks.json
# Dev HS256 id_tokens (never in prod):
# OIDC_HS_SECRET=dev-oidc-hs-secret-min-32-chars-long!!
# OIDC_DEFAULT_ORG_ID=org_acme

# ── Docker Compose ────────────────────────────────────────────────
POSTGRES_USER=proofroom
POSTGRES_PASSWORD=proofroom
POSTGRES_DB=proofroom
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8787
WEB_PORT=8080

# TLS profile (docker-compose.tls.yml)
# CADDY_DOMAIN=localhost
# HTTPS_PORT=443
# HTTP_PORT=80

# ── LLM (server-only — never commit real keys) ────────────────────
# Mistral (default if MISTRAL_API_KEY set)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# Grok / xAI (SpaceXAI) — set LLM_PROVIDER=xai and XAI_API_KEY
# LLM_PROVIDER=xai
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.5

# See deploy/SECRETS.md for production checklist
